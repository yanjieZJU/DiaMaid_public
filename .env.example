# Chat model API
OPENAI_API_KEY=replace-with-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=replace-with-a-compatible-chat-model

# Knowledge graph (Neo4j)
NEO4J_URL=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-your-password

# Graph embedding service
EMBED_API_KEY=replace-with-your-embedding-api-key
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# Optional image chat and document illustration features
DASHSCOPE_API_KEY=replace-with-your-api-key
